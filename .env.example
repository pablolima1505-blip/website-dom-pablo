# Copie para .env.local e preencha. Tudo é opcional: vazio = recurso desligado.
NEXT_PUBLIC_SITE_URL=https://www.dompablobarbearia.com.br
# Google Analytics 4 (ex.: G-XXXXXXXXXX). Só carrega após o consentimento do visitante.
NEXT_PUBLIC_GA4_ID=
# Meta Pixel (ID numérico, público). Só carrega após o consentimento do visitante.
META_PIXEL_ID=
# API de Conversões da Meta: token SÓ nas variáveis da Vercel (Settings > Environment Variables). Nunca aqui, nunca no GitHub.
META_CAPI_ACCESS_TOKEN=
# Opcional: código da aba "Testar eventos" do Gerenciador de Eventos (apague depois de validar)
META_TEST_EVENT_CODE=
